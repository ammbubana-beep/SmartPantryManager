<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        style="@style/SectionTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/pantry_pulse_title"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:weightSum="3">

        <LinearLayout
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="14dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/pantry_pulse_total" android:textColor="@color/text_secondary"/>
            <TextView android:id="@+id/tvPulseTotal"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="0" android:textSize="32sp" android:textStyle="bold"
                android:textColor="@color/stat_total"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="14dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/pantry_pulse_soon" android:textColor="@color/text_secondary"/>
            <TextView android:id="@+id/tvPulseSoon"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="0" android:textSize="32sp" android:textStyle="bold"
                android:textColor="@color/stat_coming_up"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="14dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/pantry_pulse_expired" android:textColor="@color/text_secondary"/>
            <TextView android:id="@+id/tvPulseExpired"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="0" android:textSize="32sp" android:textStyle="bold"
                android:textColor="@color/stat_expired"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>